# Bind viewing to your home server's LAN address when ready.
TELLYBOX_BIND=127.0.0.1
TELLYBOX_PORT=8082
# Optional: the HOME server's Tailscale IPv4 address. Relay must target port 8083.
TELLYBOX_RELAY_BIND=127.0.0.1
# For setup from another home device, set this to the server's LAN IPv4 before starting.
# Leave loopback to use SSH forwarding instead. Never use 0.0.0.0 or a public IP.
TELLYBOX_SETUP_BIND=127.0.0.1
