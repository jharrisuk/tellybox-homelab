# Bind viewing to your home server's LAN address when ready.
TELLYBOX_BIND=127.0.0.1
TELLYBOX_PORT=8082
# Optional: the HOME server's Tailscale IPv4 address. Relay must target port 8083.
TELLYBOX_RELAY_BIND=127.0.0.1
# For setup from another home device, set this to the server's LAN IPv4 before starting.
# Leave loopback to use SSH forwarding instead. Never use 0.0.0.0 or a public IP.
TELLYBOX_SETUP_BIND=127.0.0.1

# Optional USB export. Leave empty to keep the feature disabled.
# Mount local media read-only at the same absolute path Jellyfin reports,
# and mount only the actual USB volume read-write. See docs/USB-EXPORT.md.
TELLYBOX_EXPORT_MEDIA_ROOTS=
TELLYBOX_EXPORT_USB_ROOT=
# Optional: /run/tellybox-export/helper.sock when using packaging/usb-helper.
TELLYBOX_EXPORT_HELPER_SOCKET=

# Optional static and artwork CDN. Default off. Leave empty for a fresh install.
# Only a private installation supplies a real HTTPS origin and secret.
# PUBLIC_ASSET_CDN_ORIGIN=https://cdn.example.com
# PUBLIC_ARTWORK_CDN_ORIGIN=          # defaults to PUBLIC_ASSET_CDN_ORIGIN
# PUBLIC_ARTWORK_CDN_SECRET=          # 32+ random bytes; never commit
# PUBLIC_ARTWORK_CDN_PRIVATE=1        # only with an edge verifier that checks expiry
# PUBLIC_ARTWORK_CDN_PRIVATE_TTL_MS=300000  # 30s-15min; bounds revocation after sign-out
